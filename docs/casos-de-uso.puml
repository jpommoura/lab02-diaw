@startuml
left to right direction
actor Cliente
actor "Agente (Empresa)" as Empresa
actor "Agente (Banco)" as Banco
Empresa --|> Agente
Banco --|> Agente
actor Agente
rectangle "Sistema de Aluguel de Carros" {
  usecase "Cadastrar-se / Autenticar (login)" as UC1
  usecase "Gerenciar cadastro de cliente (CRUD)" as UC2
  usecase "Criar pedido de aluguel" as UC3
  usecase "Modificar pedido" as UC4
  usecase "Consultar status do pedido" as UC5
  usecase "Cancelar pedido" as UC6
  usecase "Avaliar pedido (análise financeira)" as UC7
  usecase "Executar contrato" as UC8
  usecase "Registrar contrato de crédito" as UC9
  usecase "Gerenciar automóveis" as UC10
  usecase "Consultar clientes" as UC11
}
Cliente --> UC1
Cliente --> UC2
Cliente --> UC3
Cliente --> UC4
Cliente --> UC5
Cliente --> UC6
Cliente --> UC10
Agente --> UC1
Agente --> UC4
Agente --> UC5
Agente --> UC7
Agente --> UC8
Agente --> UC10
Agente --> UC11
Banco --> UC9
UC9 .> UC7 : <<extend>>
UC3 .> UC1 : <<include>>
@enduml
